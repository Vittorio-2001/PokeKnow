---
import Base from '../layouts/Base.astro';
import abilitiesJson from '../data/generated/abilities.json';
import { GAMES, VERSIONS, VERSION_BY_SLUG, type Ability, type Lang, type Pokemon, defaultVersion, isPresent, padId, text } from '../lib/data';
import { localePath, t } from '../lib/i18n';
import { type Neighbour, movesFor } from '../lib/paths';
import { renderMoves } from '../lib/moves';
import { megasIn, renderMegaButtons } from '../lib/forms';
import type { WhereData } from '../lib/where';
import type { ChainMember } from '../lib/chain';
import { catchChance } from '../lib/stats';
import footprintsJson from '../data/footprints.json';
import { shapeIcon } from '../lib/shapes';
import { renderView, roman } from '../lib/render';
import { themeFor } from '../lib/themes';
import { href } from '../lib/url';

interface Props {
  pokemon: Pokemon;
  where: WhereData;
  chain: ChainMember[];
  prev: Neighbour | null;
  next: Neighbour | null;
  lang: Lang;
}

const { pokemon, where, chain, prev, next, lang } = Astro.props;
const ui = t(lang);
const allAbilities = abilitiesJson as Record<string, Ability>;

// Solo le abilità che servono a questa pagina finiscono nel payload del browser.
const abilityIds = new Set(
  [...Object.values(pokemon.abilitiesByGen).flat(), ...(pokemon.megas ?? []).flatMap((m) => m.abilities)].map((a) => String(a.id)),
);
const abilities = Object.fromEntries([...abilityIds].map((id) => [id, allAbilities[id]]));

const version = defaultVersion(pokemon, lang);
const view = renderView(pokemon, abilities, version, lang, where, chain);
const name = text(pokemon.name, lang);
const genus = text(pokemon.genus, lang);
// Mosse: nell'HTML solo quelle del gioco predefinito; per gli altri giochi il browser scarica /data/moves/<id>.json.
const game = VERSION_BY_SLUG.get(version)!.game;
const movesHtml = renderMoves(movesFor(pokemon.id), game.group, game.gen, game.order, view.versionName, lang);
const locale = lang === 'it' ? 'it-IT' : 'en-US';
// Impronte dalla raccolta di veekun: esistono nei giochi fino alla Gen V, e non per tutti (chi non ha piedi non lascia impronte).
const footprint = (footprintsJson as Record<string, string>)[pokemon.id] ?? null;
const path = `pokemon/${pokemon.slug}/`;

const generations = [...new Set(GAMES.map((g) => g.gen))];
// `<` codificato: il JSON vive dentro un tag <script> e non deve poterlo chiudere.
const payload = JSON.stringify({ pokemon, abilities, where, chain, defaultVersion: version }).replaceAll('<', '\\u003c');

// Per lo script nell'<head>: tema di ogni versione in cui il Pokémon è presente.
const themeByVersion = Object.fromEntries(
  VERSIONS.filter((v) => isPresent(pokemon, v.game.group)).map((v) => {
    const theme = themeFor(v.game.group);
    return [v.slug, [theme.key, theme.pixel ? 'pixel' : 'smooth']];
  }),
);
---

<Base
  title={`${name} — PokéKnow`}
  description={ui.pokemonDescription(name, genus)}
  lang={lang}
  path={path}
  theme={view.theme.key}
  version={version}
  pixel={view.theme.pixel}
  image={`og/${lang}/${pokemon.slug}.jpg`}
>
  <!-- Applica il tema del gioco scelto prima del primo disegno: niente lampo del tema sbagliato. -->
  <script is:inline slot="head" define:vars={{ themeByVersion }}>
    try {
      const params = new URLSearchParams(location.search);
      const pick = params.get('gioco') || params.get('game') || localStorage.getItem('pokeknow:gioco');
      const theme = pick && themeByVersion[pick];
      if (theme) {
        const root = document.documentElement;
        root.dataset.theme = theme[0];
        root.dataset.sprite = theme[1];
        root.dataset.version = pick;
      }
    } catch {}
  </script>

  <article class="wrap entry" data-entry>
    <header class="entry-head">
      <div>
        <p class="entry-head__n">#{padId(pokemon.id)}</p>
        <h1 class="entry-head__name display" data-name>{name}</h1>
        <p class="entry-head__genus">
          {genus}
          {pokemon.legendary && <span class="tag">{ui.legendary}</span>}
          {pokemon.mythical && <span class="tag">{ui.mythical}</span>}
        </p>
      </div>
      <div class="game-picker">
        <label for="game">{ui.game}</label>
        <select id="game">
          {
            generations.map((gen) => (
              <optgroup label={ui.generation(roman(gen))}>
                {GAMES.filter((g) => g.gen === gen).flatMap((g) =>
                  g.versions.map((v) => (
                    <option value={v.slug} selected={v.slug === version} disabled={!isPresent(pokemon, g.group)}>
                      {text(v.name, lang)}
                      {!isPresent(pokemon, g.group) ? ` ${ui.absent}` : ''}
                    </option>
                  )),
                )}
              </optgroup>
            ))
          }
        </select>
      </div>
    </header>

    <div class="stage-row">
      <div class="stage">
        <button class="shiny-toggle" type="button" aria-pressed="false" title={ui.shinyLabel} data-shiny-toggle>
          <span aria-hidden="true">✦</span> {ui.shiny}
        </button>
        <button class="cry-button" type="button" aria-label={ui.playCry(name)} title={ui.playCry(name)} data-cry>
          <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" shape-rendering="crispEdges">
            <path d="M1 6h3l4-4h1v12H8l-4-4H1z" fill="currentColor" />
            <path d="M11 5h1v6h-1zM13 3h1v10h-1z" fill="currentColor" />
          </svg>
          {ui.cry}
        </button>
        <div class="mega-buttons" data-mega-buttons set:html={renderMegaButtons(megasIn(pokemon, game.group), lang, null)} />
        <img
          class="pixelated"
          data-stage-sprite
          crossorigin="anonymous"
          src={view.sprite}
          alt={ui.spriteAlt(name, view.versionName)}
          width="96"
          height="96"
        />
      </div>

      <div class="stage-side">
        <div class="dialog" data-dialog>
          <p class="dialog__game" data-version-name>{ui.dexOf(view.versionName)}</p>
          <div data-slot="flavor" set:html={view.slots.flavor} />
          <span class="dialog__cursor" aria-hidden="true"></span>
        </div>

        <div class="facts">
          <div data-slot="types" set:html={view.slots.types} />
          {
            footprint && (
              <svg
                class="footprint"
                viewBox="0 0 16 16"
                role="img"
                aria-label={`${ui.footprint}: ${name}`}
                shape-rendering="crispEdges"
              >
                <title>{ui.footprint}</title>
                <path d={footprint} fill="currentColor" />
              </svg>
            )
          }
          <dl>
            <div>
              <dt>{ui.height}</dt>
              <dd data-height>{pokemon.height.toLocaleString(locale)} m</dd>
            </div>
            <div>
              <dt>{ui.weight}</dt>
              <dd data-weight>{pokemon.weight.toLocaleString(locale)} kg</dd>
            </div>
            {
              pokemon.shape && (
                <div class="facts__shape">
                  <dt>{ui.shape}</dt>
                  <dd>
                    <Fragment set:html={shapeIcon(pokemon.shape, ui.shapes[pokemon.shape] ?? pokemon.shape)} />
                    <span class="facts__shape-name">{ui.shapes[pokemon.shape]}</span>
                  </dd>
                </div>
              )
            }
            <div class="facts__mega" data-mega-how hidden>
              <dt>{ui.megaHow}</dt>
              <dd></dd>
            </div>
            <div>
              <dt>{ui.debut}</dt>
              <dd>Gen {roman(pokemon.gen)}</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>

    <section class="section" aria-labelledby="h-chain">
      <div class="section__head">
        <h2 class="section__title display" id="h-chain">{ui.chainTitle}</h2>
        <p class="section__aside">{ui.chainAside}</p>
      </div>
      <div data-slot="chain" set:html={view.slots.chain} />
    </section>

    <section class="section" aria-labelledby="h-defense">
      <div class="section__head">
        <h2 class="section__title display" id="h-defense">{ui.defense}</h2>
        <p class="section__aside" data-slot="generation" set:html={view.slots.generation} />
      </div>
      <div data-slot="defense" set:html={view.slots.defense} />
    </section>

    <section class="section" aria-labelledby="h-offense">
      <div class="section__head">
        <h2 class="section__title display" id="h-offense">{ui.offense}</h2>
        <p class="section__aside">{ui.offenseAside}</p>
      </div>
      <div data-slot="offense" set:html={view.slots.offense} />
    </section>

    <div class="two-col">
      <section class="section" aria-labelledby="h-stats">
        <div class="section__head">
          <h2 class="section__title display" id="h-stats">{ui.baseStats}</h2>
        </div>
        <div data-slot="stats" set:html={view.slots.stats} />
      </section>

      <section class="section" aria-labelledby="h-abilities">
        <div class="section__head">
          <h2 class="section__title display" id="h-abilities">{ui.abilities}</h2>
        </div>
        <div data-slot="abilities" set:html={view.slots.abilities} />
      </section>
    </div>

    <section class="section" aria-labelledby="h-training">
      <div class="section__head">
        <h2 class="section__title display" id="h-training">{ui.trainingTitle}</h2>
      </div>
      <dl class="training">
        <div>
          <dt>{ui.catchRate}</dt>
          <dd>
            {pokemon.capture}
            <span class="training__sub">{ui.catchChance(`${catchChance(pokemon.capture).toLocaleString(locale, { maximumFractionDigits: 1 })}%`)}</span>
          </dd>
        </div>
        {pokemon.happiness !== null && (
          <div>
            <dt>{ui.baseHappiness}</dt>
            <dd>{pokemon.happiness}</dd>
          </div>
        )}
        {pokemon.baseExp !== null && (
          <div>
            <dt>{ui.baseExp}</dt>
            <dd>{pokemon.baseExp}</dd>
          </div>
        )}
        {pokemon.growth && (
          <div>
            <dt>{ui.growthRate}</dt>
            <dd>{ui.growthRates[pokemon.growth] ?? pokemon.growth}</dd>
          </div>
        )}
        <div>
          <dt>{ui.gender}</dt>
          <dd>
            {pokemon.genderRate < 0
              ? ui.genderless
              : ui.genderSplit(
                  `${((8 - pokemon.genderRate) * 12.5).toLocaleString(locale)}%`,
                  `${(pokemon.genderRate * 12.5).toLocaleString(locale)}%`,
                )}
          </dd>
        </div>
        {pokemon.eggGroups.length > 0 && (
          <div>
            <dt>{ui.eggGroups}</dt>
            <dd>{pokemon.eggGroups.map((g) => text(g, lang)).join(', ')}</dd>
          </div>
        )}
        {pokemon.hatch !== null && (
          <div>
            <dt>{ui.eggCycles}</dt>
            <dd>{ui.eggCyclesValue(pokemon.hatch)}</dd>
          </div>
        )}
      </dl>
    </section>

    <section class="section" aria-labelledby="h-where">
      <div class="section__head">
        <h2 class="section__title display" id="h-where">{ui.whereTitle}</h2>
        <p class="section__aside">{ui.whereAside}</p>
      </div>
      <div data-slot="where" set:html={view.slots.where} />
    </section>

    <section class="section" aria-labelledby="h-dex">
      <div class="section__head">
        <h2 class="section__title display" id="h-dex">{ui.regionalDex}</h2>
      </div>
      <div data-slot="dex" set:html={view.slots.dex} />
    </section>

    <section class="section" aria-labelledby="h-moves">
      <div class="section__head">
        <h2 class="section__title display" id="h-moves">{ui.movesTitle}</h2>
        <p class="section__aside">{ui.movesAside}</p>
      </div>
      <div data-moves set:html={movesHtml} />
    </section>

    <nav class="pager" aria-label={ui.nearby}>
      {
        prev && (
          <a href={href(localePath(lang, `pokemon/${prev.slug}/`))} rel="prev">
            <span class="pager__dir">{ui.previous}</span>
            <span class="pager__name">
              #{padId(prev.id)} {text(prev.name, lang)}
            </span>
          </a>
        )
      }
      {
        next && (
          <a class="pager__next" href={href(localePath(lang, `pokemon/${next.slug}/`))} rel="next">
            <span class="pager__dir">{ui.next}</span>
            <span class="pager__name">
              #{padId(next.id)} {text(next.name, lang)}
            </span>
          </a>
        )
      }
    </nav>
  </article>

  <script type="application/json" id="payload" set:html={payload} />
</Base>

<script>
  import { VERSION_BY_SLUG, isPresent, text, type Ability, type Pokemon } from '../lib/data';
  import type { WhereData } from '../lib/where';
  import type { ChainMember } from '../lib/chain';
  import { GAME_PARAM, isLang, t } from '../lib/i18n';
  import { cryUrl, defaultSpriteUrl, renderView } from '../lib/render';
  import { placeSprite } from '../lib/sprite-anchor';
  import { type MovesData, filterMoves, renderMoves } from '../lib/moves';
  import { asMega, megasIn, renderMegaButtons, renderMegaHow } from '../lib/forms';
  import { href } from '../lib/url';

  // Il gioco scelto si ricorda tra le lingue: stessa chiave, parametro dell'URL tradotto.
  const STORAGE_KEY = 'pokeknow:gioco';
  const lang = isLang(document.documentElement.lang) ? document.documentElement.lang : 'it';
  const ui = t(lang);
  const PARAM = GAME_PARAM[lang];

  const { pokemon, abilities, where, chain, defaultVersion } = JSON.parse(document.getElementById('payload')!.textContent!) as {
    pokemon: Pokemon;
    abilities: Record<string, Ability>;
    where: WhereData;
    chain: ChainMember[];
    defaultVersion: string;
  };

  const root = document.documentElement;
  const select = document.querySelector<HTMLSelectElement>('#game')!;
  const sprite = document.querySelector<HTMLImageElement>('.stage img')!;
  const dialog = document.querySelector<HTMLElement>('[data-dialog]')!;
  const versionLabel = document.querySelector<HTMLElement>('[data-version-name]')!;
  const stage = document.querySelector<HTMLElement>('.stage')!;
  const langLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]')];
  const slots = new Map(
    [...document.querySelectorAll<HTMLElement>('[data-slot]')].map((el) => [el.dataset.slot!, el]),
  );
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const name = text(pokemon.name, lang);

  function readStorage(): string | null {
    try {
      return localStorage.getItem(STORAGE_KEY);
    } catch {
      return null;
    }
  }

  function writeStorage(value: string) {
    try {
      localStorage.setItem(STORAGE_KEY, value);
    } catch {
      /* navigazione privata: pazienza, resta l'URL */
    }
  }

  const usable = (slug: string | null): slug is string => {
    const v = slug ? VERSION_BY_SLUG.get(slug) : undefined;
    return !!v && isPresent(pokemon, v.game.group);
  };

  // Cambiando lingua si resta sullo stesso gioco.
  function updateLangLinks(slug: string) {
    for (const link of langLinks) {
      const other = link.dataset.langLink;
      if (!isLang(other)) continue;
      const url = new URL(link.href);
      url.search = '';
      url.searchParams.set(GAME_PARAM[other], slug);
      link.href = url.href;
    }
  }

  // Fa comparire il testo carattere per carattere, come nei giochi. Un clic lo completa.
  let typing = 0;
  let skip: AbortController | null = null;
  function typeOut(el: HTMLElement | null) {
    cancelAnimationFrame(typing);
    skip?.abort();
    dialog.classList.remove('is-typing');
    if (!el || reduceMotion) return;
    const full = el.textContent ?? '';
    const start = performance.now();
    const msPerChar = 18;
    dialog.classList.add('is-typing');
    el.setAttribute('aria-label', full);
    const step = (now: number) => {
      const n = Math.min(full.length, Math.floor((now - start) / msPerChar));
      el.textContent = full.slice(0, n);
      if (n < full.length) typing = requestAnimationFrame(step);
      else {
        dialog.classList.remove('is-typing');
        el.removeAttribute('aria-label');
      }
    };
    typing = requestAnimationFrame(step);
    skip = new AbortController();
    dialog.addEventListener(
      'click',
      () => {
        cancelAnimationFrame(typing);
        el.textContent = full;
        el.removeAttribute('aria-label');
        dialog.classList.remove('is-typing');
      },
      { once: true, signal: skip.signal },
    );
  }

  // Megaevoluzione mostrata (slug della forma), se nel gioco scelto esiste.
  let megaSlug: string | null = null;
  const megaButtons = document.querySelector<HTMLElement>('[data-mega-buttons]')!;
  const nameEl = document.querySelector<HTMLElement>('[data-name]')!;
  const heightEl = document.querySelector<HTMLElement>('[data-height]')!;
  const weightEl = document.querySelector<HTMLElement>('[data-weight]')!;
  const megaHow = document.querySelector<HTMLElement>('[data-mega-how]')!;
  const locale = lang === 'it' ? 'it-IT' : 'en-US';

  function show(slug: string, animate: boolean) {
    const { game } = VERSION_BY_SLUG.get(slug)!;
    const megas = megasIn(pokemon, game.group);
    const mega = megas.find((m) => m.slug === megaSlug) ?? null;
    if (!mega) megaSlug = null;
    // la Mega attiva resta nell'URL, così il link condiviso la mostra
    const url = new URL(location.href);
    if (megaSlug) url.searchParams.set('mega', megaSlug);
    else url.searchParams.delete('mega');
    history.replaceState(null, '', url);
    megaButtons.innerHTML = renderMegaButtons(megas, lang, megaSlug);
    const shown = mega ? text(mega.name, lang) : name;
    nameEl.textContent = shown;
    heightEl.textContent = `${(mega?.height ?? pokemon.height).toLocaleString(locale)} m`;
    weightEl.textContent = `${(mega?.weight ?? pokemon.weight).toLocaleString(locale)} kg`;
    megaHow.hidden = !mega;
    megaHow.querySelector('dd')!.innerHTML = mega ? renderMegaHow(mega, lang) : '';

    const view = renderView(mega ? asMega(pokemon, mega) : pokemon, abilities, slug, lang, where, chain);
    for (const [key, html] of Object.entries(view.slots)) {
      const el = slots.get(key);
      if (el) el.innerHTML = html;
    }

    root.dataset.theme = view.theme.key;
    root.dataset.sprite = view.theme.pixel ? 'pixel' : 'smooth';
    root.dataset.version = slug;

    versionLabel.textContent = ui.dexOf(view.versionName);
    sprite.alt = ui.spriteAlt(shown, view.versionName);
    current = view;
    currentGen = view.gen;
    setSprite();
    select.value = slug;
    updateLangLinks(slug);
    showMoves(slug, view.versionName);
    if (animate) typeOut(slots.get('flavor')!.querySelector<HTMLElement>('.dialog__text:not(.dialog__text--empty)'));
  }

  // Mosse: il file con tutti i giochi si scarica una volta sola, al primo cambio di gioco.
  const movesBox = document.querySelector<HTMLElement>('[data-moves]')!;
  let movesData: Promise<MovesData> | null = null;
  let movesTicket = 0;
  let openTab = 'L';
  let movesQuery = '';

  movesBox.addEventListener('input', (event) => {
    const input = event.target as HTMLInputElement;
    if (!input.matches('[data-moves-search]')) return;
    movesQuery = input.value;
    filterMoves(movesBox, movesQuery);
  });

  function showMoves(slug: string, versionName: string) {
    const { game } = VERSION_BY_SLUG.get(slug)!;
    const ticket = ++movesTicket;
    const draw = (data: MovesData) => {
      if (ticket !== movesTicket) return;
      const focused = document.activeElement?.matches('[data-moves-search]');
      movesBox.innerHTML = renderMoves(data, game.group, game.gen, game.order, versionName, lang, openTab);
      // la ricerca resta cambiando gioco
      const input = movesBox.querySelector<HTMLInputElement>('[data-moves-search]');
      if (input) {
        input.value = movesQuery;
        filterMoves(movesBox, movesQuery);
        if (focused) input.focus();
      }
    };
    if (!movesData) {
      movesBox.innerHTML = `<p class="muted">${ui.movesLoading}</p>`;
      movesData = fetch(href(`data/moves/${pokemon.id}.json`)).then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
      movesData.catch(() => (movesData = null)); // al prossimo cambio di gioco ci riprova
    }
    movesData.then(draw, () => {
      if (ticket === movesTicket) movesBox.innerHTML = `<p class="muted">${ui.movesError}</p>`;
    });
  }

  // Schede Livello / MT / Uova / Insegnamosse; la scheda aperta resta tale cambiando gioco.
  movesBox.addEventListener('click', (event) => {
    const tab = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-method]');
    if (!tab) return;
    openTab = tab.dataset.method!;
    for (const b of movesBox.querySelectorAll<HTMLButtonElement>('[data-method]')) b.setAttribute('aria-selected', String(b === tab));
    for (const panel of movesBox.querySelectorAll<HTMLElement>('[data-panel]')) panel.hidden = panel.dataset.panel !== openTab;
  });
  movesBox.addEventListener('keydown', (event) => {
    if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
    const tabs = [...movesBox.querySelectorAll<HTMLButtonElement>('[data-method]')];
    const i = tabs.indexOf(event.target as HTMLButtonElement);
    if (i < 0) return;
    const next = tabs[(i + (event.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
    next.focus();
    next.click();
  });

  // Nella catena evolutiva la carta della Mega di questo Pokémon fa come il pulsante sul palco.
  slots.get('chain')!.addEventListener('click', (event) => {
    const card = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-chain-mega]');
    if (!card?.dataset.chainMega) return;
    event.preventDefault();
    megaSlug = megaSlug === card.dataset.chainMega ? null : card.dataset.chainMega;
    show(select.value, false);
    document.querySelector('.entry-head')?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
  });

  // Pulsanti Mega sul palco: un clic mostra la forma, un secondo clic torna alla forma normale.
  megaButtons.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-mega]');
    if (!button) return;
    megaSlug = megaSlug === button.dataset.mega ? null : button.dataset.mega!;
    show(select.value, false);
  });

  // Verso: il pulsante sul palco (o un clic sullo sprite) lo riproduce e fa "saltare" il Pokémon.
  const cryButton = document.querySelector<HTMLButtonElement>('[data-cry]')!;
  let currentGen = renderView(pokemon, abilities, defaultVersion, lang, where, chain).gen;
  let audio: HTMLAudioElement | null = null;

  function cheer() {
    if (reduceMotion) return;
    sprite.classList.remove('is-crying');
    void sprite.offsetWidth; // fa ripartire l'animazione anche con clic ripetuti
    sprite.classList.add('is-crying');
  }

  function playCry() {
    const { primary, fallback } = cryUrl(pokemon.id, currentGen);
    audio?.pause();
    const start = (src: string, last: boolean) => {
      const a = new Audio(src);
      a.volume = 0.6;
      audio = a;
      a.addEventListener('playing', cheer, { once: true });
      a.play().catch(() => {
        if (!last) start(fallback, true);
        else {
          cryButton.disabled = true;
          cryButton.title = ui.cryUnavailable;
        }
      });
    };
    start(primary, primary === fallback);
  }

  cryButton.addEventListener('click', playCry);
  sprite.addEventListener('click', playCry);
  sprite.addEventListener('animationend', () => sprite.classList.remove('is-crying'));

  // Sprite shiny: un interruttore sul palco, ricordato tra le pagine.
  const SHINY_KEY = 'pokeknow:shiny';
  const shinyButton = document.querySelector<HTMLButtonElement>('[data-shiny-toggle]')!;
  let shiny = false;
  try {
    shiny = localStorage.getItem(SHINY_KEY) === '1';
  } catch {}
  let current: { sprite: string; spriteShiny: string } = { sprite: sprite.src, spriteShiny: '' };

  function setSprite() {
    shinyButton.setAttribute('aria-pressed', String(shiny));
    const wanted = shiny && current.spriteShiny ? current.spriteShiny : current.sprite;
    sprite.onerror = () => {
      // se manca lo shiny di quel gioco si torna allo sprite normale, poi a quello standard
      sprite.onerror = () => {
        sprite.onerror = null;
        sprite.src = defaultSpriteUrl(pokemon.id, shiny);
      };
      sprite.src = current.sprite;
    };
    if (sprite.src === wanted) place(); // stesso sprite, tema diverso: riallinea
    else sprite.src = wanted;
  }

  shinyButton.addEventListener('click', () => {
    shiny = !shiny;
    try {
      localStorage.setItem(SHINY_KEY, shiny ? '1' : '0');
    } catch {}
    setSprite();
  });

  // Allinea lo sprite alla piattaforma (o al centro) appena l'immagine è pronta.
  let placing = 0;
  function place() {
    const ticket = ++placing;
    sprite.classList.remove('is-placed');
    const reveal = () => ticket === placing && sprite.classList.add('is-placed');
    const fallback = setTimeout(reveal, 1500); // se la misura tarda, mostra comunque lo sprite
    placeSprite(sprite, stage).finally(() => {
      clearTimeout(fallback);
      reveal();
    });
  }
  sprite.addEventListener('load', place);
  if (sprite.complete && sprite.naturalWidth) place();

  select.addEventListener('change', () => {
    const slug = select.value;
    writeStorage(slug);
    const url = new URL(location.href);
    url.searchParams.delete('gioco');
    url.searchParams.delete('game');
    url.searchParams.set(PARAM, slug);
    history.replaceState(null, '', url);
    show(slug, true);
  });

  // Priorità: gioco nell'URL (in una delle due lingue), poi l'ultimo scelto, poi quello di default della pagina.
  const params = new URLSearchParams(location.search);
  const fromUrl = params.get(PARAM) ?? params.get('gioco') ?? params.get('game');
  const initial = [fromUrl, readStorage()].find(usable);
  // ?mega=charizard-mega-x arriva dalla catena evolutiva di un altro Pokémon: si apre con la Mega attiva
  megaSlug = params.get('mega');
  if (megaSlug) show(initial ?? defaultVersion, false);
  else if (initial && initial !== defaultVersion) show(initial, false);
  else {
    if (initial) updateLangLinks(initial);
    current = renderView(pokemon, abilities, defaultVersion, lang, where, chain);
    if (shiny) setSprite();
    else shinyButton.setAttribute('aria-pressed', 'false');
  }
</script>
