---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/themes.css';
import { href } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Tema del gioco (solo nelle schede); senza, resta il tema base in bianco e nero. */
  theme?: string;
  version?: string;
  pixel?: boolean;
}

const { title, description, theme, version, pixel = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

---

<!doctype html>
<html lang="it" data-theme={theme} data-version={version} data-sprite={theme ? (pixel ? 'pixel' : 'smooth') : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={href('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://raw.githubusercontent.com" />
    <slot name="head" />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap masthead__inner">
        <a class="logo display" href={href()}>PokéKnow</a>
        <nav aria-label="Principale">
          <a href={href('#cerca')}>Cerca</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <p>
          PokéKnow è un progetto amatoriale e senza scopo di lucro. Non è affiliato con Nintendo, Creatures Inc., GAME FREAK
          o The Pokémon Company. Pokémon e i nomi dei personaggi sono marchi dei rispettivi proprietari. I temi sono
          ispirati alle interfacce dei giochi di ogni epoca.
        </p>
        <p>Dati e sprite: <a href="https://pokeapi.co">PokéAPI</a>.</p>
      </div>
    </footer>
  </body>
</html>
